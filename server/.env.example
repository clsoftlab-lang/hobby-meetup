#
# Copy this file to `.env` (which is git-ignored) and fill in your real key.
# The key lives ONLY here on the server — never in the browser or the repo.

# Your Anthropic API key (starts with sk-ant-...). Do NOT commit the real value.
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_KEY

# Port the proxy listens on (frontend AI_ENDPOINT must match).
PORT=8787

# Optional: cost-first model default. Raise for higher quality.
# AI_MODEL=claude-haiku-4-5        # or claude-sonnet-5 / claude-opus-5
# AI_MAX_TOKENS=700                # per-task output cap
# AI_EFFORT=low                    # effort for non-Haiku models only

# Optional cost guardrails.
# AI_RATE_PER_MIN=20               # per-IP requests/minute
# AI_MONTHLY_TOKEN_CAP=2000000     # monthly token budget → 429 {fallback:true}

# Optional: restrict CORS to your site's origin instead of "*".
# CORS_ORIGIN=http://localhost:8917
